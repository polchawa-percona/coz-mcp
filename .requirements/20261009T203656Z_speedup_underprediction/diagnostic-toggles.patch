+    if(ns > 0) _sample_period = _sample_event_period = ns;
+  }
+
+  /// coz-mcp: what to do with time a pause sleeps beyond what was needed.
+  enum class overshoot_mode {
+    propagate,  //< upstream: the thread is ahead, so every other thread pauses too
+    drop,       //< diagnostics: forget it (the thread really lost that time)
+    bank        //< keep it for this thread and pay its next delays from it
+  };
+  void set_overshoot_mode(overshoot_mode m) { _overshoot_mode = m; }
+
+  /// coz-mcp: how selected-line samples taken inside a lock become delay.
